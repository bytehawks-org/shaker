#!/usr/bin/env bash
#
# shaker.libsh - Shaker loader and framework housekeeping.
#
# Sourcing this file loads every library in the right order. Libraries only
# define functions and (non-exported) data, they never act on source.

_SHAKER_LIB_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

. "${_SHAKER_LIB_DIR}/validate.libsh"
. "${_SHAKER_LIB_DIR}/log.libsh"
. "${_SHAKER_LIB_DIR}/core.libsh"
. "${_SHAKER_LIB_DIR}/os.libsh"
. "${_SHAKER_LIB_DIR}/pkg.libsh"
. "${_SHAKER_LIB_DIR}/fs.libsh"
. "${_SHAKER_LIB_DIR}/file.libsh"
. "${_SHAKER_LIB_DIR}/net.libsh"
. "${_SHAKER_LIB_DIR}/hook.libsh"
. "${_SHAKER_LIB_DIR}/rosetta.libsh"
. "${_SHAKER_LIB_DIR}/state.libsh"
. "${_SHAKER_LIB_DIR}/service.libsh"
. "${_SHAKER_LIB_DIR}/spec.libsh"
. "${_SHAKER_LIB_DIR}/lifecycle.libsh"

unset _SHAKER_LIB_DIR


###############################################################################
#
# Function: cleanup_bh_shaker_env_vars
#
# Removes all environment variables that start with the prefix "BH_SHAKER_",
# so that the framework state does not leak into the application environment.
# Shaker's own paths are kept in unexported variables and keep working.
#
###############################################################################
cleanup_bh_shaker_env_vars() {

    local var vars_to_unset=()

    for var in "${!BH_SHAKER_@}"; do
        vars_to_unset+=("${var}")
    done

    if (( ${#vars_to_unset[@]} > 0 )); then
        log_event "debug" "Cleaning up variables: ${vars_to_unset[*]}"
        unset "${vars_to_unset[@]}"
    fi

}


###############################################################################
#
# Function: debug_bh_shaker_env_vars
#
# Logs (debug level) all BH_SHAKER_* variables. Values of secret-looking
# variables are redacted.
#
###############################################################################
debug_bh_shaker_env_vars() {

    local var value

    log_event "debug" "BH_SHAKER_ available environment variables:"

    for var in "${!BH_SHAKER_@}"; do
        value="${!var}"
        is_secret_name "${var}" && value="********"
        log_event "debug" "Environment variable: ${var}=${value}"
    done

}


##############################################################################
#
# Function: print_welcome_banner
#
# Prints the banner unless BH_SHAKER_DISABLE_BANNER is true. The banner goes
# to stderr so it never pollutes machine-readable stdout.
#
# Returns:
#   0 on success, 1 if the banner file is missing.
#
##############################################################################
print_welcome_banner() {

    local banner="${SHAKER_ASSETS}/banner.txt"

    if [[ ! -f "${banner}" ]]; then
        log_event "warn" "Banner file not found at ${banner}"
        return 1
    fi

    if is_boolean_yes "${BH_SHAKER_DISABLE_BANNER:-false}"; then
        log_event "debug" "Banner disabled via BH_SHAKER_DISABLE_BANNER"
        return 0
    fi

    cat "${banner}" >&2

}
