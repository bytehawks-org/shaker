#!/usr/bin/env bash
#
# fs.libsh - filesystem, user and permission helpers.
# Equivalent of Bitnami's libfs.sh and the user helpers of libos.sh.
# Only POSIX options of find/chmod/chown are used (busybox compatible).


##############################################################################
#
# Function: am_i_root
#
# Returns 0 when running as uid 0.
#
##############################################################################
am_i_root() {
    [[ "${EUID}" -eq 0 ]]
}


##############################################################################
#
# Function: is_dir_empty
#
# Returns 0 if the directory does not exist or has no entries (hidden files
# included).
#
##############################################################################
is_dir_empty() {

    local dir="${1:?directory required}"

    [[ ! -d "${dir}" ]] && return 0
    [[ -z "$(ls -A "${dir}" 2>/dev/null)" ]]

}


##############################################################################
#
# Function: ensure_dir_exists
#
# Creates a directory (with parents) and optionally sets owner and mode.
#
# Usage:
#   ensure_dir_exists <dir> [owner[:group]] [mode]
#
##############################################################################
ensure_dir_exists() {

    local dir="${1:?directory required}" owner="${2:-}" mode="${3:-}"

    mkdir -p "${dir}" || return 1
    [[ -n "${mode}" ]]  && { chmod "${mode}" "${dir}" || return 1; }
    [[ -n "${owner}" ]] && { chown "${owner}" "${dir}" || return 1; }
    return 0

}


##############################################################################
#
# Function: configure_permissions_ownership
#
# Recursively applies ownership and modes, separately for directories and
# files. With group 0 and g+rwX it gives the OpenShift/arbitrary-uid behaviour
# of Bitnami images (writable by any uid that belongs to the root group).
#
# Usage:
#   configure_permissions_ownership <path> [-u user] [-g group] [-d dir-mode] [-f file-mode]
#
##############################################################################
configure_permissions_ownership() {

    local path="${1:?path required}" user="" group="" dmode="" fmode=""
    shift

    while (( $# > 0 )); do
        case "$1" in
            -u) user="$2";  shift 2 ;;
            -g) group="$2"; shift 2 ;;
            -d) dmode="$2"; shift 2 ;;
            -f) fmode="$2"; shift 2 ;;
            *)  log_event "error" "configure_permissions_ownership: unknown option '$1'"; return 1 ;;
        esac
    done

    [[ -e "${path}" ]] || { log_event "error" "Path not found: ${path}"; return 1; }

    if [[ -n "${user}${group}" ]]; then
        chown -R "${user}${group:+:${group}}" "${path}" || return 1
    fi
    [[ -n "${dmode}" ]] && find "${path}" -type d -exec chmod "${dmode}" {} +
    [[ -n "${fmode}" ]] && find "${path}" -type f -exec chmod "${fmode}" {} +
    return 0

}


##############################################################################
#
# Function: ensure_group_exists / ensure_user_exists
#
# Idempotently create a system group / user, using useradd/groupadd where
# available and the busybox addgroup/adduser otherwise.
#
# Usage:
#   ensure_group_exists <name> [gid]
#   ensure_user_exists  <name> [uid] [group] [home]
#
##############################################################################
ensure_group_exists() {

    local name="${1:?group name required}" gid="${2:-}"

    getent group "${name}" >/dev/null 2>&1 && return 0

    if command -v groupadd >/dev/null 2>&1; then
        local sysflag=()
        if [[ -z "${gid}" || "${gid}" -lt 1000 ]]; then sysflag=(-r); fi
        groupadd "${sysflag[@]+"${sysflag[@]}"}" ${gid:+-g "${gid}"} "${name}"
    else
        addgroup -S ${gid:+-g "${gid}"} "${name}"
    fi

}

ensure_user_exists() {

    local name="${1:?user name required}" uid="${2:-}" group="${3:-}" home="${4:-}"

    id -u "${name}" >/dev/null 2>&1 && return 0
    [[ -n "${group}" ]] && ensure_group_exists "${group}"

    if command -v useradd >/dev/null 2>&1; then
        local sysflag=()
        # -r (system account) only below SYS_UID_MAX, otherwise useradd warns
        if [[ -z "${uid}" || "${uid}" -lt 1000 ]]; then sysflag=(-r); fi
        useradd "${sysflag[@]+"${sysflag[@]}"}" -M -s /usr/sbin/nologin \
            ${uid:+-u "${uid}"} ${group:+-g "${group}"} ${home:+-d "${home}"} "${name}"
    else
        adduser -S -D -H -s /sbin/nologin \
            ${uid:+-u "${uid}"} ${group:+-G "${group}"} ${home:+-h "${home}"} "${name}"
    fi

}


##############################################################################
#
# Function: has_setpriv
#
# True only for util-linux setpriv. BusyBox (Alpine) ships an applet with the same name that
# cannot change uid/gid, so the command being present is not enough.
#
##############################################################################
has_setpriv() {

    command -v setpriv >/dev/null 2>&1 && setpriv --help 2>&1 | grep -q -- '--reuid'

}


##############################################################################
#
# Function: run_as_user
#
# Runs a command as another user, picking the first available tool:
# setpriv, runuser, gosu, su-exec, su. When already that user (or when the
# caller is not root) the command is executed directly.
#
# Usage:
#   run_as_user <user> <command> [args...]
#
##############################################################################
run_as_user() {

    local user="${1:?user required}"; shift

    if [[ "$(id -un)" == "${user}" ]] || ! am_i_root; then
        "$@"
    elif has_setpriv; then
        setpriv --reuid="${user}" --regid="${user}" --init-groups "$@"
    elif command -v runuser >/dev/null 2>&1; then
        runuser -u "${user}" -- "$@"
    elif command -v gosu >/dev/null 2>&1; then
        gosu "${user}" "$@"
    elif command -v su-exec >/dev/null 2>&1; then
        su-exec "${user}" "$@"
    else
        su -s /bin/sh "${user}" -c "$(printf '%q ' "$@")"
    fi

}


##############################################################################
#
# Function: generate_random_string
#
# Prints a random alphanumeric string.
#
# Usage:
#   generate_random_string [length=32]
#
##############################################################################
generate_random_string() {

    local length="${1:-32}"

    # tr gets SIGPIPE when head closes the pipe: ignore it in a subshell
    ( set +o pipefail; LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c "${length}" )
    echo

}


##############################################################################
#
# Function: exec_as_user
#
# Replaces the current process with a command running as another user, so the
# service stays PID 1 and receives container signals. Prefers tools that exec
# directly (setpriv, gosu, su-exec); runuser/su are a last resort because they
# stay in between as a parent process.
#
# Usage:
#   exec_as_user <uid|user> <gid|group> <command> [args...]
#
##############################################################################
exec_as_user() {

    local user="${1:?user required}" group="${2:?group required}"; shift 2

    if has_setpriv; then
        exec setpriv --reuid="${user}" --regid="${group}" --init-groups "$@"
    elif command -v gosu >/dev/null 2>&1; then
        exec gosu "${user}:${group}" "$@"
    elif command -v su-exec >/dev/null 2>&1; then
        exec su-exec "${user}:${group}" "$@"
    elif command -v runuser >/dev/null 2>&1; then
        log_event "warn" "setpriv/gosu/su-exec not found: using runuser, signals reach the service through a parent process"
        exec runuser -u "${user}" -- "$@"
    fi

    log_event "error" "No tool available to drop privileges (install util-linux's setpriv, gosu or su-exec; on Alpine: apk add su-exec)"
    return 1

}


##############################################################################
#
# Function: ensure_passwd_entry
#
# Makes the current uid resolvable when the platform assigns an arbitrary uid
# (OpenShift, restricted PodSecurity). Many programs (postgres, ssh, java,
# whoami) fail when getpwuid() has no answer. Strategy, in order:
#   1. /etc/passwd writable (group 0 convention): append an entry
#   2. libnss_wrapper available: private passwd/group files + LD_PRELOAD
#   3. warn and continue
# Nothing is done for root or when the uid is already known.
#
# Usage:
#   ensure_passwd_entry [name=bytehawks] [home=/tmp]
#
# Test hook: SHAKER_PASSWD_FILE / SHAKER_GROUP_FILE replace /etc/passwd and /etc/group.
#
##############################################################################
ensure_passwd_entry() {

    local name="${1:-bytehawks}" home="${2:-/tmp}"
    local uid gid passwd="${SHAKER_PASSWD_FILE:-/etc/passwd}" group="${SHAKER_GROUP_FILE:-/etc/group}"
    local nss_lib dir

    uid="$(id -u)"; gid="$(id -g)"
    (( uid == 0 )) && return 0

    if [[ -r "${passwd}" ]] && grep -q "^[^:]*:[^:]*:${uid}:" "${passwd}"; then
        return 0
    fi

    if [[ -w "${passwd}" ]]; then
        printf '%s:x:%s:%s:%s user:%s:/sbin/nologin\n' "${name}" "${uid}" "${gid}" "${name}" "${home}" >> "${passwd}"
        log_event "debug" "Added uid ${uid} to ${passwd}"
        return 0
    fi

    for nss_lib in /usr/lib/libnss_wrapper.so /usr/lib64/libnss_wrapper.so /usr/lib/*/libnss_wrapper.so /usr/lib/libnss_wrapper.so.0; do
        [[ -r "${nss_lib}" ]] && break
        nss_lib=""
    done

    if [[ -n "${nss_lib}" ]]; then
        dir="$(mktemp -d "${TMPDIR:-/tmp}/bh-nss.XXXXXX")" || return 1
        cp "${passwd}" "${dir}/passwd" 2>/dev/null || : > "${dir}/passwd"
        cp "${group}" "${dir}/group" 2>/dev/null || : > "${dir}/group"
        printf '%s:x:%s:%s:%s user:%s:/sbin/nologin\n' "${name}" "${uid}" "${gid}" "${name}" "${home}" >> "${dir}/passwd"
        export NSS_WRAPPER_PASSWD="${dir}/passwd" NSS_WRAPPER_GROUP="${dir}/group"
        export LD_PRELOAD="${nss_lib}${LD_PRELOAD:+:${LD_PRELOAD}}"
        log_event "debug" "uid ${uid} resolved through nss_wrapper (${nss_lib})"
        return 0
    fi

    log_event "warn" "uid ${uid} has no passwd entry and neither a writable ${passwd} nor nss_wrapper is available"
    return 0

}
