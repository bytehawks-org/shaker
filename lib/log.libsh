#!/usr/bin/env bash
#
# log.libsh - logging to stderr. Equivalent of Bitnami's liblog.sh.
#
# Environment variables:
#   BH_SHAKER_QUIET      - "true" suppresses all output.
#   BH_SHAKER_DEBUG      - "true" is a shortcut for BH_SHAKER_LOG_LEVEL=debug.
#   BH_SHAKER_LOG_LEVEL  - debug | info (default) | warn | error.
#   BH_SHAKER_COLOR      - forces colors on/off (default: on for terminals and CI).
#   BH_SHAKER_MODULE     - optional module name added to every line.


RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DARK_GRAY='\033[1;30m'
LIGHT_PURPLE='\033[0;95m'
MAGENTA='\033[0;35m'
COLOR_RESET='\033[0m'


##############################################################################
#
# Function: stderr_print
#
# Prints the given arguments to standard error unless quiet mode is enabled.
#
# Arguments:
#   $* - The message(s) to print to standard error.
#
##############################################################################
stderr_print() {

    if ! is_boolean_yes "${BH_SHAKER_QUIET:-false}"; then
        printf "%b\\n" "$*" >&2
    fi

}


##############################################################################
#
# Function: log_level_value
#
# Maps a log level name to a number (debug=0 info=1 warn=2 error=3).
# Unknown levels map to info.
#
##############################################################################
log_level_value() {

    case "${1,,}" in
        debug) echo 0 ;;
        info)  echo 1 ;;
        warn)  echo 2 ;;
        error) echo 3 ;;
        *)     echo 1 ;;
    esac

}


##############################################################################
#
# Function: log_full_message
#
# Logs a full message to stderr with optional color formatting and module name.
# The timestamp uses the bash builtin printf %(...)T, so no process is forked.
#
# Arguments:
#   $@  - The message to log.
#
##############################################################################
log_full_message() {

    local default_color="true"

    if [[ ! -t 2 && -z "${GITHUB_ACTIONS:-}" && -z "${CI:-}" ]]; then
        default_color="false"
    fi

    local color_log="${BH_SHAKER_COLOR:-${default_color}}"
    local module_name="${BH_SHAKER_MODULE:+[ ${BH_SHAKER_MODULE} ] }"
    local timestamp
    printf -v timestamp '%(%Y-%m-%d %T)T' -1

    if is_boolean_yes "${color_log}"; then
        stderr_print "${DARK_GRAY}${timestamp} ${LIGHT_PURPLE}${module_name}${COLOR_RESET}${*}"
    else
        stderr_print "${timestamp} ${module_name}${*}"
    fi

}


##############################################################################
#
# Function: log_event
#
# Logs an event message with a level, honouring BH_SHAKER_LOG_LEVEL.
#
# Usage:
#   log_event <level> <message...>
#
##############################################################################
log_event() {

    local default_color="true"

    if [[ ! -t 2 && -z "${GITHUB_ACTIONS:-}" && -z "${CI:-}" ]]; then
        default_color="false"
    fi

    local color_log="${BH_SHAKER_COLOR:-${default_color}}"
    local log_level
    log_level="$(normalize_case "upper" "${1:-UNKNOWN}")"
    local log_level_color=""
    local min_level="${BH_SHAKER_LOG_LEVEL:-info}"

    shift || true

    if is_boolean_yes "${BH_SHAKER_DEBUG:-false}"; then
        min_level="debug"
    fi

    if (( $(log_level_value "${log_level}") < $(log_level_value "${min_level}") )); then
        return 0
    fi

    if is_boolean_yes "${color_log}"; then
        case "${log_level}" in
            INFO)  log_level_color="${GREEN}" ;;
            WARN)  log_level_color="${YELLOW}" ;;
            ERROR) log_level_color="${RED}" ;;
            DEBUG) log_level_color="${MAGENTA}" ;;
            *)     log_level_color="${COLOR_RESET}" ;;
        esac
    fi

    log_full_message "${log_level_color}[${log_level}]${COLOR_RESET} $*"

}


log_debug() { log_event "debug" "$@"; }
log_info()  { log_event "info"  "$@"; }
log_warn()  { log_event "warn"  "$@"; }
log_error() { log_event "error" "$@"; }


##############################################################################
#
# Function: die
#
# Logs an error and exits the shell (or returns 1 when sourced interactively).
#
# Usage:
#   die <message...>
#
##############################################################################
die() {

    log_event "error" "$@"
    exit 1

}
