#!/usr/bin/env bash
#
# shaker - hardened initialization and configuration for container and legacy
# VM/server deployments. Part of the ByteHawks project.

set -o errexit
set -o nounset
set -o pipefail

SHAKER_BIN="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/shaker.libsh
. "${SHAKER_BIN}/../lib/shaker.libsh"

usage() {
    cat <<USAGE
shaker $(shaker_version)

Usage: shaker <command> [options]

  detect [--format=text|env]          show deployment, OS, init, arch, libc, package manager
  env <package> [opts] [-- cmd...]    resolve parameters (CLI > ENV > ENV_FILE > alias > config > default)
        --format=export|dotenv|explain   output format (default: export)
        --map=FILE       Rosetta map (default: \$BH_ROOT/<package>/.bytehawks/rosetta.map)
        --config=FILE    configuration file (default: auto-discovered for legacy hosts)
        --validate       only validate, print nothing
        --help-vars      describe the parameters of the package
        --<flag>=value   any CLI flag declared in the map
  exec <package> [opts] -- cmd...     resolve, export, clean framework vars and exec cmd
  render <template> [dest]            render {{ VAR }} / {{ VAR:-default }} from the environment
  pkg <install|remove|update|clean|check> [names...]   distro-agnostic package management
  hooks <dir>                         run init hooks in lexical order
  wait-for <host> <port> [seconds]    wait for a TCP port
  bootstrap                           create /opt/bytehawks layout and /opt/bh symlink
  banner | version | help
USAGE
}

cmd_detect() {

    local format="text" var

    [[ "${1:-}" == --format=* ]] && format="${1#--format=}"
    detect_all

    for var in "${!BH_SHAKER_@}"; do
        case "${var}" in
            BH_SHAKER_OS_*|BH_SHAKER_DEPLOYMENT_*|BH_SHAKER_INIT_*|BH_SHAKER_ARCH|BH_SHAKER_LIBC)
                if [[ "${format}" == "env" ]]; then
                    printf 'export %s=%q\n' "${var}" "${!var}"
                else
                    printf '%-48s %s\n' "${var}" "${!var}"
                fi
                ;;
        esac
    done

}

# Shared by `env` and `exec`: parses options, loads map/config, resolves.
# Sets SHAKER_FORMAT, SHAKER_VALIDATE_ONLY, SHAKER_HELP_VARS.
resolve_package() {

    local pkg="$1"; shift
    local map="" config="" arg
    local -a cli_args=()

    SHAKER_FORMAT="export"; SHAKER_VALIDATE_ONLY="false"; SHAKER_HELP_VARS="false"
    SHAKER_CMD=()

    while (( $# > 0 )); do
        arg="$1"; shift
        case "${arg}" in
            --format=*)  SHAKER_FORMAT="${arg#--format=}" ;;
            --map=*)     map="${arg#--map=}" ;;
            --config=*)  config="${arg#--config=}" ;;
            --validate)  SHAKER_VALIDATE_ONLY="true" ;;
            --help-vars) SHAKER_HELP_VARS="true" ;;
            --)          SHAKER_CMD=("$@"); break ;;
            *)           cli_args+=("${arg}") ;;
        esac
    done

    [[ -n "${map}" ]] || map="${BH_ROOT}/${pkg}/.bytehawks/rosetta.map"

    rosetta_reset
    rosetta_load_map "${map}" || return 1

    [[ "${SHAKER_HELP_VARS}" == "true" ]] && return 0

    [[ -n "${config}" ]] || config="$(rosetta_find_config "${pkg}" || true)"
    if [[ -n "${config}" ]]; then
        rosetta_load_config "${config}" || return 1
    else
        log_event "debug" "No configuration file for ${pkg}: using environment and defaults only"
    fi

    rosetta_parse_cli "${cli_args[@]+"${cli_args[@]}"}" || return 1
    rosetta_resolve

}

cmd_env() {

    local pkg="${1:?package required}"; shift

    resolve_package "${pkg}" "$@" || exit 1

    if [[ "${SHAKER_HELP_VARS}" == "true" ]]; then rosetta_describe; return 0; fi
    if [[ "${SHAKER_VALIDATE_ONLY}" == "true" ]]; then return 0; fi

    rosetta_print "${SHAKER_FORMAT}"

}

cmd_exec() {

    local pkg="${1:?package required}"; shift

    resolve_package "${pkg}" "$@" || exit 1
    (( ${#SHAKER_CMD[@]} > 0 )) || die "exec: command missing (use: shaker exec <package> [opts] -- cmd...)"

    rosetta_export
    if [[ "${BH_SHAKER_LOG_LEVEL:-}" == "debug" || "${BH_SHAKER_DEBUG:-}" == "true" ]]; then
        rosetta_print explain >&2
    fi
    cleanup_bh_shaker_env_vars
    exec "${SHAKER_CMD[@]}"

}

main() {

    local command="${1:-help}"
    shift || true

    case "${command}" in
        detect)     cmd_detect "$@" ;;
        env)        detect_all; cmd_env "$@" ;;
        exec)       detect_all; cmd_exec "$@" ;;
        render)     render_template "$@" ;;
        pkg)
            local op="${1:?pkg operation required}"; shift
            detect_os; detect_package_manager
            case "${op}" in
                install)   pkg_install "$@" ;;
                remove)    pkg_remove "$@" ;;
                update)    pkg_update ;;
                clean)     pkg_clean ;;
                check)     pkg_is_installed "$@" ;;
                *)         die "Unknown pkg operation '${op}'" ;;
            esac
            ;;
        hooks)      run_hooks "$@" ;;
        wait-for)   wait_for_port "$@" ;;
        bootstrap)  shaker_bootstrap ;;
        banner)     print_welcome_banner ;;
        version)    shaker_version ;;
        help|-h|--help) usage ;;
        *)          usage >&2; exit 2 ;;
    esac

}

main "$@"
