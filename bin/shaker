#!/usr/bin/env bash
#
# shaker - hardened initialization and configuration for container and legacy
# VM/server deployments. Part of the ByteHawks project.

set -o errexit
set -o nounset
set -o pipefail

SHAKER_BIN="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/shaker.libsh
. "${SHAKER_BIN}/../lib/shaker.libsh"

usage() {
    cat <<USAGE
shaker $(shaker_version)

Usage: shaker <command> [options]

Lifecycle (driven by the Distillery bundle of the package):
  install <pkg>              user, directories, permissions (root, once)
  init <pkg> [opts]          parameters -> templates, persistence, hooks (idempotent, every start)
  run <pkg> [opts] [-- args] init + start the service (PID 1; --daemon for hosts without supervisor)
  stop <pkg>                 stop a service started with --daemon
  verify <pkg> [--strict] [--no-health]   audit: user, permissions, parameters, drift, health
  status <pkg>               what was applied and when
  unit <pkg>                 print a hardened systemd unit

Parameters (Rosetta):
  env <pkg> [opts]           resolve CLI > ENV > ENV_FILE > alias > config file > default
        --format=export|dotenv|explain   --validate   --help-vars
        --config=FILE   --bundle=DIR   --map=FILE   --<flag>=value (flags declared by the package)
  exec <pkg> [opts] -- cmd   resolve, export, clean framework variables, exec cmd

Tools:
  detect [--format=text|env]            deployment, OS, family, init, arch, libc, package manager
  render <template> [dest]              render {{ VAR }} / {{ VAR:-default }} from the environment
  pkg <install|remove|update|clean|check> [names...]   distro-agnostic package management
  hooks <dir>                           run init hooks in lexical order
  wait-for <host> <port> [seconds]      wait for a TCP port
  bootstrap                             create the /opt/bytehawks layout and the /opt/bh symlink
  banner | version | help
USAGE
}

cmd_detect() {

    local format="text" var

    [[ "${1:-}" == --format=* ]] && format="${1#--format=}"
    detect_all

    for var in "${!BH_SHAKER_@}"; do
        case "${var}" in
            BH_SHAKER_OS_*|BH_SHAKER_DEPLOYMENT_*|BH_SHAKER_INIT_*|BH_SHAKER_ARCH|BH_SHAKER_LIBC)
                if [[ "${format}" == "env" ]]; then
                    printf 'export %s=%q\n' "${var}" "${!var}"
                else
                    printf '%-48s %s\n' "${var}" "${!var}"
                fi
                ;;
        esac
    done

}

cmd_env() {

    lifecycle_parse_args "$@"
    lifecycle_load || exit 1
    lifecycle_resolve || exit 1

    if [[ "${LC_HELP_VARS}" == "true" ]]; then rosetta_describe; return 0; fi
    if [[ "${LC_VALIDATE_ONLY}" == "true" ]]; then return 0; fi

    rosetta_print "${LC_FORMAT}"

}

cmd_exec() {

    lifecycle_parse_args "$@"
    lifecycle_load || exit 1
    lifecycle_resolve || exit 1
    (( ${#LC_EXTRA[@]} > 0 )) || die "exec: command missing (use: shaker exec <package> [opts] -- cmd...)"

    if [[ "${BH_SHAKER_LOG_LEVEL:-}" == "debug" || "${BH_SHAKER_DEBUG:-}" == "true" ]]; then
        rosetta_print explain >&2
    fi
    cleanup_bh_shaker_env_vars
    exec "${LC_EXTRA[@]}"

}

# install / init / run / stop / verify / status / unit
cmd_lifecycle() {

    local verb="$1"; shift

    lifecycle_parse_args "$@"
    lifecycle_load || exit 1

    case "${verb}" in
        install) lifecycle_install ;;
        stop)    lifecycle_stop ;;
        status)  lifecycle_status ;;
        unit)    lifecycle_unit ;;
        init|run|verify)
            lifecycle_resolve || { state_event "${LC_PKG}" "${verb}" fail parameters; exit 1; }
            "lifecycle_${verb}"
            ;;
    esac

}

main() {

    local command="${1:-help}"
    shift || true

    case "${command}" in
        detect)     cmd_detect "$@" ;;
        env)        detect_all; cmd_env "$@" ;;
        exec)       detect_all; cmd_exec "$@" ;;
        install|init|run|stop|verify|status|unit)
                    detect_all; cmd_lifecycle "${command}" "$@" ;;
        render)     render_template "$@" ;;
        pkg)
            local op="${1:?pkg operation required}"; shift
            detect_os; detect_package_manager
            case "${op}" in
                install)   pkg_install "$@" ;;
                remove)    pkg_remove "$@" ;;
                update)    pkg_update ;;
                clean)     pkg_clean ;;
                check)     pkg_is_installed "$@" ;;
                *)         die "Unknown pkg operation '${op}'" ;;
            esac
            ;;
        hooks)      run_hooks "$@" ;;
        wait-for)   wait_for_port "$@" ;;
        bootstrap)  shaker_bootstrap ;;
        banner)     print_welcome_banner ;;
        version)    shaker_version ;;
        help|-h|--help) usage ;;
        *)          usage >&2; exit 2 ;;
    esac

}

main "$@"
